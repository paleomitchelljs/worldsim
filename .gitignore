# Simulation output (lives outside the repo; see sim/docs/running.md)
sim/runs/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# World file: 210 MB, over GitHub's 100 MB limit. Rebuilt by
# build_world_gis.py / derive_world.py; keep a local copy.
gis/world.gpkg

# QA registration images (38 MB, regenerated by the world build);
# keep the registration parameters
gis/qa/*
!gis/qa/registration.json

# Saved simulation states and LaTeX/run byproducts
*.pkl
*.aux
*.log

# Local Claude Code settings
.claude/
